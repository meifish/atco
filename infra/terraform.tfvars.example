region                = "ca-central-1"
tailnet_dns_name      = "tail1234.ts.net" # Tailscale admin console > DNS > Tailnet name
tailscale_hostname    = "inceptionai"     # deployment choice: site is https://inceptionai.tail1234.ts.net (code default: redline-diff)
cognito_domain_prefix = "redline-diff-login-yourcompany"
image_tag             = "replace-with-output-of-scripts/push-images.sh"
web_desired_count     = 2
